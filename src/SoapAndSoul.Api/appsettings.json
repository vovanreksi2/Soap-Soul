{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=App_Data/soapandsoul.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "SeedSampleData": false
  },
  "Images": {
    "Provider": "Local",
    "Path": "App_Data/images",
    "MaxBytes": 5242880
  },
  "Llm": {
    "Provider": "None",
    "Model": "claude-opus-5-5",
    "Effort": "Low"
  },
  "Mcp": {
    "Enabled": true,
    "ApiKey": "",
    "AllowAnonymous": false
  }
}
