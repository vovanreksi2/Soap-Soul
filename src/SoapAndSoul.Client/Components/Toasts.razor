@implements IDisposable
@inject ToastService Service

<div class="toasts" aria-live="polite">
    @foreach (var t in Service.Toasts)
    {
        <div class="toast @t.CssClass" @key="t.Id"><i class="ph @t.Icon"></i>@t.Text</div>
    }
</div>

@code {
    protected override void OnInitialized() => Service.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Service.Changed -= OnChanged;
}
